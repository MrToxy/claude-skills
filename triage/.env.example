# Copy to .env (gitignored) and fill in. Nothing here is baked into the image.

# ---- Secrets (runtime only) --------------------------------------------------------------------
# Subscription OAuth token — mint on your Mac with:  claude setup-token   (1-year, subscription-billed).
# MUST start with sk-ant-oat01-. NEVER put an ANTHROPIC_API_KEY here — this runner is subscription-only.
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...

# GitHub: fine-grained PAT scoped to ONLY the target repos, with Contents + Pull requests = write
# (no admin, no other repos). Used for both `gh` and `git push` over HTTPS.
GH_TOKEN=github_pat_...

# npm auth for the private @yourscope/* packages the repos install (repos' .npmrc reads ${NPM_TOKEN}).
NPM_TOKEN=npm_...

# Linear personal API key (Linear → Settings → API) — authenticates the hosted Linear MCP headlessly
# via `Authorization: Bearer`. MUST include the "write" scope (the pipeline transitions issue state to
# claim a ticket); a read-only / comments-only key fails issueUpdate with 403. Inference stays on your
# subscription; this only connects the tracker.
LINEAR_API_KEY=lin_api_...

# ---- Host paths to bind-mount (your machine) ---------------------------------------------------
CLAUDE_SKILLS_DIR=/Users/you/Documents/Development/claude-skills
AGENTS_SKILLS_DIR=/Users/you/.agents/skills
ROUTING_CONFIG=/Users/you/path/to/project/.claude/auto-triage.config.json

# ---- Tuning (optional) -------------------------------------------------------------------------
TRIAGE_ONLY_SITES=site-a          # limit clones for a fast first run; empty = every site in routing.map
TRIAGE_MAX_SPEND_5H_USD=25     # headless budget fallback if the subscription usage% is unreadable
TICK_INTERVAL=900              # seconds between ticks in loop mode
GIT_AUTHOR_NAME=auto-triage
GIT_AUTHOR_EMAIL=auto-triage@users.noreply.github.com

# ---- Sidecar endpoints for the repos' integration tests (M2) -----------------------------------
DATABASE_URL=postgres://triage:triage@postgres:5432/triage
DYNAMODB_ENDPOINT=http://dynamodb:8000
