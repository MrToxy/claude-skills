#!/usr/bin/env bash
# triage-all — one scheduler pass: run a per-site tick (`triage-tick <site>`) for every site in the
# project's routing map, SEQUENTIALLY, each provisioning only that site's sidecars. This is what the
# host scheduler (launchd/cron) fires each interval. Single-instance via an mkdir lock, so a long tick
# never overlaps the next fire. Sites come from the config unless `TRIAGE_ONLY_SITES` pins a subset.
set -uo pipefail

ENV_FILE="${CONTAINER_ENV_FILE:-$HOME/.claude-triage/container.env}"
[ -f "$ENV_FILE" ] || { echo "FATAL: env file not found: $ENV_FILE" >&2; exit 1; }
set -a; . "$ENV_FILE"; set +a
CFG="${ROUTING_CONFIG:?ROUTING_CONFIG must be set in $ENV_FILE}"
HERE="$(cd "$(dirname "$0")" && pwd)"
command -v jq >/dev/null 2>&1 || { echo "FATAL: jq required on the host" >&2; exit 1; }

LOCK="${CLAUDE_TRIAGE_DIR:-$HOME/.claude-triage}/triage-all.lock"
mkdir "$LOCK" 2>/dev/null || { echo "triage-all: a pass is already running ($LOCK); skip"; exit 0; }
trap 'rmdir "$LOCK" 2>/dev/null || true' EXIT

# Sites = routing.map keys, unless TRIAGE_ONLY_SITES pins a subset (comma- or space-separated).
if [ -n "${TRIAGE_ONLY_SITES:-}" ]; then
  sites=$(printf '%s' "$TRIAGE_ONLY_SITES" | tr ',' ' ')
else
  sites=$(jq -r '.routing.map | keys[]' "$CFG")
fi

for s in $sites; do
  echo "=== triage-all: tick $s ($(date -u +%FT%TZ)) ==="
  # Each site gets its own scope; unset the pin so triage-tick sets it per-site itself.
  TRIAGE_ONLY_SITES="" "$HERE/triage-tick" "$s" || echo "triage-all: $s tick failed (continuing)"
done
